# Supabase (primary project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Supabase (interviews project, if separate from primary)
INTERVIEWS_SUPABASE_URL=
INTERVIEWS_SUPABASE_SERVICE_ROLE_KEY=

# Supabase (Quroosh project). Server only: the secret key, never a
# NEXT_PUBLIC_ name. QUROOSH_SUPABASE_DB_URL is for npm run db:push:quroosh
# from a laptop and does not belong in Vercel.
QUROOSH_SUPABASE_URL=
QUROOSH_SUPABASE_SECRET_KEY=
QUROOSH_SUPABASE_DB_URL=

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_REMINDER_MINUTES=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Mock Interviews email stays held unless this is "on" (docs/interviews.md)
INTERVIEWS_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
SITE_URL=
CRON_SECRET=

# Event attendance: the key another system sends to /api/event-attendance/...
# (Authorization: Bearer <key>). Server only. Without it that API answers 401.
EVENT_ATTENDANCE_API_KEY=
