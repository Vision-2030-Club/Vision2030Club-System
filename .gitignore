# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Agent skills, installed per-developer rather than shared
/.agents/
# Claude Code: personal settings and local skills stay out; the shared rules go in.
/.claude/*
!/.claude/rules/
/skills-lock.json

# Real member data — national IDs, phones, emails for ~100 people.
# Kept out of git deliberately: a private repo is not a controlled store for
# personal data, history is permanent, and members-import.csv is regenerated
# from the spreadsheet by scripts/build-member-csv.mjs whenever it is needed.
*.xlsx
members-import.csv

# Source video masters. The .mov is a 21 MB QuickTime/ProRes editing file no
# browser can play; keep masters in Drive. A web-encoded copy belongs in
# public/ and is committed deliberately, not dragged in from the repo root.
/*.mp4
/*.mov

# Database backups taken by scripts/reset-for-testing.mjs — real national IDs.
/backups/

# KPI simulation input: real names and grades, never committed
/simulation-data/
"/Development VC2030/"
